{
    "schema_version": 1,
    "video_presets": [
        {
            "id": "av1_nvenc",
            "name": "AV1 NVENC",
            "description": "Encoding AV1 con accelerazione NVIDIA NVENC",
            "category": "video",
            "output_extension": null,
            "output_suffix": "_AV1_CQ{cq}",
            "ffmpeg": {
                "hwaccel": ["-hwaccel", "cuda", "-hwaccel_output_format", "cuda"],
                "video_codec": ["-c:v", "av1_nvenc"],
                "rate_control": ["-rc", "vbr"],
                "quality_template": ["-cq", "{cq}"],
                "preset_template": ["-preset", "{preset}"],
                "extra_video_args": [
                    "-b:v", "0",
                    "-tune", "hq",
                    "-rc-lookahead", "64",
                    "-spatial-aq", "1",
                    "-temporal-aq", "1",
                    "-g", "120",
                    "-bf", "2"
                ],
                "container_args": ["-movflags", "+faststart"],
                "audio_args": ["-c:a", "copy"]
            },
            "ui": {
                "cq": {
                    "enabled": true,
                    "default": 0,
                    "min": 0,
                    "max": 51
                },
                "preset": {
                    "enabled": true,
                    "default": "p6",
                    "options": ["p1", "p2", "p3", "p4", "p5", "p6", "p7"]
                },
                "scale": {
                    "enabled": true
                }
            }
        },
        {
            "id": "xvid_avi",
            "name": "Comprimi Xvid",
            "description": "Compressione software Xvid in container AVI",
            "category": "video",
            "output_extension": ".avi",
            "output_suffix": "_xvid",
            "ffmpeg": {
                "hwaccel": [],
                "video_codec": ["-c:v", "libxvid"],
                "rate_control": [],
                "quality_template": ["-q:v", "{quality}"],
                "preset_template": [],
                "extra_video_args": [],
                "container_args": [],
                "audio_args": ["-c:a", "libmp3lame", "-q:a", "4"]
            },
            "ui": {
                "quality": {
                    "enabled": true,
                    "default": 4,
                    "min": 1,
                    "max": 31,
                    "label": "Qualità Xvid q:v"
                },
                "scale": {
                    "enabled": true
                }
            }
        }
    ],
    "animation_presets": {
        "defaults": {
            "fps": 15,
            "target_width": 1920,
            "width_options": [1920, 1280, 720],
            "webp_quality": 70,
            "webp_method": 6,
            "avif_crf": 32,
            "avif_preset": 6,
            "avif_encoder": "libsvtav1",
            "gif_colors": 64,
            "gif_lossy": 100,
            "gif_dither": "bayer:bayer_scale=3"
        }
    }
}
