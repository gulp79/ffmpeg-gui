{
    "schema_version": 1,
    "video_presets": [
        {
            "id": "av1_nvenc",
            "name": "AV1 NVENC",
            "description": "Encoding AV1 con accelerazione NVIDIA NVENC",
            "category": "video",
            "output_extension": null,
            "output_suffix": "_AV1_CQ{cq}",
            "ffmpeg": {
                "hwaccel": [
                    "-hwaccel",
                    "cuda",
                    "-hwaccel_output_format",
                    "cuda"
                ],
                "video_codec": [
                    "-c:v",
                    "av1_nvenc"
                ],
                "rate_control": [
                    "-rc",
                    "vbr"
                ],
                "quality_template": [
                    "-cq",
                    "{cq}"
                ],
                "preset_template": [
                    "-preset",
                    "{preset}"
                ],
                "extra_video_args": [
                    "-b:v",
                    "0",
                    "-tune",
                    "hq",
                    "-rc-lookahead",
                    "64",
                    "-spatial-aq",
                    "1",
                    "-temporal-aq",
                    "1",
                    "-g",
                    "120",
                    "-bf",
                    "2"
                ],
                "container_args": [
                    "-movflags",
                    "+faststart"
                ],
                "audio_args": [
                    "-c:a",
                    "copy"
                ]
            },
            "ui": {
                "cq": {
                    "enabled": true,
                    "default": 0,
                    "min": 0,
                    "max": 51
                },
                "preset": {
                    "enabled": true,
                    "default": "p6",
                    "options": [
                        "p1",
                        "p2",
                        "p3",
                        "p4",
                        "p5",
                        "p6",
                        "p7"
                    ]
                },
                "scale": {
                    "enabled": true
                }
            }
        },
